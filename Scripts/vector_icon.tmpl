<?xml version="1.0" encoding="utf-8"?>
<!-- 由 Scripts/svg_assets.py 从 svg/{SOURCE} 生成，勿手改。
     几何与 Windows 端 icons_svg.rs 完全同源（同一份 svg/ + 同一套归一化与抽稀），
     着色由 Compose 的 Icon(tint = …) 负责，所以这里不写 android:tint ——
     纯 Compose 工程没有 appcompat 主题，`?attr/colorControlNormal` 在 AAPT 阶段就解析不了。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:pathData="{PD}" android:fillColor="#FF000000" android:fillType="nonZero" />
</vector>
